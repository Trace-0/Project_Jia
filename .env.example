# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.
# 설정 키는 config/config.py 의 Config 필드와 매핑됩니다. (예: llmModel -> JIA_LLM_MODEL)
# 주석 처리된 키는 비워두면 Config 의 기본값이 사용됩니다.

# ── LangChain / LangSmith ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=YOUR_LANGSMITH_API_KEY
LANGCHAIN_PROJECT=Project_Jia

# ── Jia 필수 설정 ──
JIA_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# ── Jia 선택 설정 ──
# JIA_JOIN_REPLY="true"
# JIA_LEAVE_REPLY="true"
# JIA_FAISS_THRESHOLD="0.5"
# JIA_WHISPER_MODEL="turbo"
# JIA_TTS_MODEL=""
# JIA_LLM_MODEL="gemma4:latest"
# JIA_LLM_SYSTEM_PROMPT=""
# JIA_LLM_TOOLS="[]"
# JIA_DEBUG_TEXT_CHANNEL=""
